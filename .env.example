# Copy to .env and fill in. NEVER commit the real .env file.
# --- SMTP (only needed for --live mode) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SENDER_NAME=Python Academy
SENDER_EMAIL=your_email@gmail.com

# --- Behaviour ---
DEFAULT_TIMEZONE=Asia/Kolkata
TICK_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=60
RATE_PER_MINUTE=60
GRACE_HOURS=24
ALLOWED_DOMAINS=
# Public URL of the API (enables open/click tracking + unsubscribe link), e.g. https://mail.example.com
TRACKING_BASE_URL=
APP_BRAND=Email Automation & Reminder System
# API server: run the scheduler inside the API process? (true/false) and dry-run or real sending
EMBEDDED_WORKER=true
DRY_RUN=true
